# ===================================================
# PrimePrint Environment Configuration Template
# Copy this file to .env and configure for your environment.
# DO NOT commit the .env file containing real secrets to GitHub!
# ===================================================

# Application Environment (production | development)
APP_ENV=production

# Application Base URL (e.g. https://primeprint.yourdomain.com or http://localhost:8000)
APP_URL=https://example.com

# Database Connection Settings
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=primeprint_db
DB_USER=primeprint_user
DB_PASSWORD=your_secure_database_password

# Razorpay Payment Gateway Credentials (Test or Live Mode)
# Public Key ID (safe for frontend HTML/JS)
RAZORPAY_KEY_ID=rzp_test_sampleKey123456

# Private Secret & Webhook Secret (Maintained strictly on server side)
RAZORPAY_KEY_SECRET=sampleKeySecret123456789
RAZORPAY_WEBHOOK_SECRET=sampleWebhookSecret123456789

