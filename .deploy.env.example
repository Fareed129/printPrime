# ===================================================
# PrimePrint Local FTP Deployment Configuration
# Copy this file to .deploy.env and fill in your Hostinger FTP credentials.
# DO NOT commit .deploy.env containing real credentials to GitHub!
# ===================================================

# Hostinger FTP Host (e.g. ftp.yourdomain.com or IP address)
FTP_HOST=ftp.yourdomain.com

# FTP Port (Standard: 21)
FTP_PORT=21

# Hostinger FTP Username (e.g. u123456789@yourdomain.com)
FTP_USERNAME=u123456789@yourdomain.com

# Hostinger FTP Password
FTP_PASSWORD=your_secure_ftp_password

# Remote Web Root Directory on Hostinger (Usually /public_html or /)
FTP_REMOTE_ROOT=/public_html

# Use FTPS (FTP over Explicit TLS / SSL) - Recommended true
FTP_USE_TLS=true
